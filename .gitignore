# ============================================================
# FasalMitra AI — .gitignore
# ============================================================

# --- Dependencies ---
node_modules/
backend/node_modules/

# --- Build outputs ---
dist/
dist-ssr/
build/

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local
*.local

# Keep the safe placeholder templates and the production public config
!.env.example
!backend/.env.example
# .env.production only contains the public Render URL — no secrets — safe to commit
!.env.production

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OS generated files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Editor directories ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Test artifacts ---
coverage/
.nyc_output/

# --- Vite cache ---
.vite/

# --- Temporary / upload cache ---
uploads/
tmp/
temp/
