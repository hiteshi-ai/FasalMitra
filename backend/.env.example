# FasalMitra AI - Backend Environment Configuration Template
# Copy this file to backend/.env to configure local settings.

# Port for the Node/Express backend server
PORT=5000

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Google Gemini API Key
# Required for plant disease diagnostics, microclimate risk assessment, and agricultural Q&A
GEMINI_API_KEY=your_gemini_api_key_here

# Weather API Configuration (Optional)
# If left blank, backend uses Open-Meteo free meteorological feed with zero key requirement.
WEATHER_API_KEY=
WEATHER_PROVIDER=open-meteo

# Supabase Free Tier Configuration (Optional for persistence)
# Find in your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Use service_role secret for backend-only database access, or anon key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Alternative key name supported:
# SUPABASE_KEY=your_supabase_key_here
